NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://tabspot:tabspot@localhost:5432/tabspot
# Required when NODE_ENV=test and by integration/e2e tests.
DATABASE_URL_TEST=postgresql://tabspot:tabspot@localhost:5433/tabspot_test

SUPABASE_URL=https://your-project.supabase.co
# JWK JSON string (single-line, double-quoted). Copy from Supabase dashboard > Settings > JWT Signing Keys.
SUPABASE_JWT_PUBLIC_KEY=replace-with-jwk-json-string

# Comma-separated browser origins allowed by CORS.
# Production requires explicit HTTPS origins. Do not use "*" in production.
# Development defaults to http://localhost:3001,http://127.0.0.1:3001 if omitted.
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# Bearer-token auth uses the Authorization header, so credentials should stay false unless cookie auth is introduced.
CORS_CREDENTIALS=false
# Keep above the 100kb ChordPro content limit plus JSON overhead.
REQUEST_BODY_LIMIT=256kb

THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Set true only for local/dev docs. Keep false in production unless intentionally exposed/protected.
ENABLE_DOCS=false
