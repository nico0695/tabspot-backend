NODE_ENV=production
PORT=3000

# Internal Docker network address for the app container.
DATABASE_URL=postgresql://tabspot:change-this-password@postgres:5432/tabspot

# Used by the postgres service in docker-compose.prod.yml.
POSTGRES_USER=tabspot
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=tabspot

SUPABASE_URL=https://your-project.supabase.co
# JWK JSON string (single-line, double-quoted). Copy from Supabase dashboard > Settings > JWT Signing Keys.
SUPABASE_JWT_PUBLIC_KEY=replace-with-jwk-json-string

# Comma-separated HTTPS origins for the frontend. Wildcards are rejected in production.
CORS_ORIGINS=https://your-frontend.example.com
CORS_CREDENTIALS=false
REQUEST_BODY_LIMIT=256kb

THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Keep disabled in production unless you intentionally expose/protect Swagger.
ENABLE_DOCS=false

# Host port is fixed in docker-compose.prod.yml as 127.0.0.1:4004:3000 for Nginx upstreaming.
